{
    "name": "steam-comment-service-bot",
    "version": "2.16.3",
    "description": "The most advanced Steam Account Manager Bot with mass coordinated comments/likes/favs/follows and plugin support",
    "main": "start.js",
    "dependencies": {
        "@seald-io/nedb": "^4.1.2",
        "@types/tail": "^2.2.3",
        "cheerio": "^0.22.0",
        "download": "^8.0.0",
        "htmlparser2": "^11.0.0",
        "https": "^1.0.0",
        "output-logger": "^2.3.8",
        "qrcode": "^1.5.4",
        "request": "^2.88.2",
        "steam-comment-bot-discord-plugin": "^1.0.4",
        "steam-comment-bot-rest": "^1.3.1",
        "steam-comment-bot-webserver": "^1.0.2",
        "steam-session": "^1.9.4",
        "steam-user": "^5.3.0",
        "steamcommunity": "^3.49.0",
        "steamid": "^2.1.0",
        "steamid-resolver": "^1.4.0"
    },
    "scripts": {
        "start": "NODE_ENV=production node start.js",
        "dev": "node scripts/generateFileStructure.js && NODE_ENV=development node start",

        "devdocs": "node scripts/generateDevDocs.js",
        "jsdocs": "jsdoc2md --clear && node scripts/generateDevDocsJsDocs.js",
        "types": "jsdoc -t node_modules/tsd-jsdoc/dist -c jsdoc.config.json -d types ; node scripts/generateFileStructure.js",
        "docs": "npm run types && npm run jsdocs && npm run devdocs",

        "deps": "ncu -u && npm update",

        "get-version": "grep \"\\\"version\\\":\" package.json | awk '{split($0,a,\" \"); print $2}' | sed -r 's/\"|,//g'",
        "docker-build": "DOCKER_BUILDKIT=1 docker build --progress=plain -t 3urobeat/steam-comment-service-bot:latest -t 3urobeat/steam-comment-service-bot:$(npm run get-version | tail -n 1) .",
        "docker-push": "docker image push 3urobeat/steam-comment-service-bot:latest && docker image push 3urobeat/steam-comment-service-bot:$(npm run get-version | tail -n 1)"
    },
    "author": "3urobeat",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/3urobeat/steam-comment-service-bot/issues"
    },
    "homepage": "https://github.com/3urobeat",
    "repository": "https://github.com/3urobeat/steam-comment-service-bot",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.1.0",
        "eslint-plugin-jsdoc": "^62.8.0",
        "jsdoc": "^4.0.5",
        "jsdoc-to-markdown": "^9.1.3",
        "jsdoc-tsimport-plugin": "^1.0.5",
        "tsd-jsdoc": "^2.5.0"
    },
    "overrides": {
        "jsdoc": "^4.0.5"
    },
    "types": "./types/types.d.ts"
}
